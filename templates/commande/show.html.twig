{% extends 'base.html.twig' %}

{% block title %}Détail de la commande{% endblock %}

{% block body %}
<div class="example-wrapper">
    <h1>Commande n° {{ commande.numero }}</h1>

    <p><strong>Date :</strong> {{ commande.date|date('d/m/Y') }}</p>
    <p><strong>Statut :</strong> {{ commande.statut }}</p>
    <p><strong>Client :</strong> {{ commande.client.prenom }} {{ commande.client.nom }}</p>

    <h3>Produits commandés</h3>
    <table border="1" style="border-collapse: collapse; width: 100%; text-align: left;">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix unitaire</th>
                <th>Quantité</th>
                <th>Montant</th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in commande.ligneCommandes %}
                <tr>
                    <td>{{ ligne.produit.nom }}</td>
                    <td>{{ ligne.prixUnitaire }} €</td>
                    <td>{{ ligne.quantite }}</td>
                    <td>{{ ligne.montant }} €</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun produit dans cette commande.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>Total : {{ commande.total }} €</h3>

    <br><br>
    <a href="{{ path('commande_edit', {'id': commande.id}) }}">Modifier</a>
    <form method="post" action="{{ path('commande_delete', {'id': commande.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cette commande ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
        <button type="submit">Supprimer</button>
    </form>
    <br><br>
    <a href="{{ path('app_commande') }}">Retour à la liste</a>
</div>
{% endblock %}